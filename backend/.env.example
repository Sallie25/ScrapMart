# Application settings
APP_NAME=ScrapMart API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development

# Neon PostgreSQL
# Replace this placeholder in your private .env file.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOSTNAME/DBNAME?sslmode=require

# Redis (Docker Compose internal network)
REDIS_URL=redis://redis:6379/0

# Public Buyer signup: exact browser origins as a JSON array (no wildcard).
AUTH_ALLOWED_ORIGINS=["http://localhost:3000"]
# Generate a separate random 32-byte base64url key; no default or checked-in key.
# .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNUP_RATE_LIMIT_SECRET=
# Buyer login uses separate counters and an independently generated limiter key.
LOGIN_RATE_LIMIT_SECRET=
# Independently generated 32-byte base64url signing key for Stage 2A access JWTs.
JWT_SIGNING_SECRET=
# Run Uvicorn with --no-proxy-headers. Trust only actual proxy IPs/networks.
AUTH_TRUSTED_PROXY_CIDRS=[]
# Production Redis must be private; use REDIS_URL with rediss:// and credentials
# when required by the selected deployment. Never publish Redis's port publicly.

# Private ID storage is disabled by default. Only enable on an operator-managed
# encrypted durable mount excluded from every public/static/proxy route.
PRIVATE_DOCUMENT_STORAGE_BACKEND=disabled
PRIVATE_DOCUMENT_STORAGE_DURABLE=false
# PRIVATE_DOCUMENT_STORAGE_ROOT=/private-durable/scrapmart-documents
# Generate a separate canonical base64url 32-byte random key for OTP HMACs.
# PHONE_OTP_SECRET=
# SMS remains unavailable until an approved SmsDelivery adapter is supplied.
