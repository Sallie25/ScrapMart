# Application settings
APP_NAME=ScrapMart API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development

# Neon PostgreSQL
# Replace this placeholder in your private .env file.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOSTNAME/DBNAME?sslmode=require

# Redis (Docker Compose internal network)
REDIS_URL=redis://redis:6379/0
